<?php /* Comparison style — the layers, hotspots and drag handles are all
         generated by modal_gallery_comparison.js from the JSON below.
         The gallery fills whatever Contao column it lands in. */ ?>

<div class="comparison_gallery"
     data-canvas-width="<?= $this->canvas_width ?>"
     data-canvas-height="<?= $this->canvas_height ?>"
     data-first-percentage="<?= $this->first_percentage ?>">

    <div class="comparison_slider"></div>

    <?php /* Single reusable modal; its content is filled on open */ ?>
    <div class="comparison_modal_overlay">
        <div class="comparison_modal">
            <button type="button" class="comparison_modal_close" aria-label="Close">&times;</button>
            <span class="comparison_modal_eyebrow"></span>
            <h2 class="comparison_modal_title"></h2>
            <div class="comparison_modal_body"></div>
        </div>
    </div>

    <?php /* Slide data, emitted server side from the DCA records */ ?>
    <script type="application/json" class="comparison_data"><?= $this->slides_serialized ?></script>
</div>
